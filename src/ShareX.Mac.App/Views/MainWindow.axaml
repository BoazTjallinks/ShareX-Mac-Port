<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShareX.Mac.App.ViewModels"
        xmlns:models="using:ShareX.Mac.App.Models"
        x:Class="ShareX.Mac.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ShareX"
        Width="1060" Height="680"
        MinWidth="780" MinHeight="480">

  <!-- Upstream MainForm layout: pToolbars docked Left (the command rail), pMain
       filling, scMain splitting the task list from the preview. Rendered with Mac
       chrome and metrics (ADR 0005). Diagnostics - permissions, displays, logs -
       deliberately live in a separate window, not here. -->
  <Grid ColumnDefinitions="240,1,*" RowDefinitions="*,Auto">

    <!-- ================= command rail (upstream tsMain) ================= -->
    <ScrollViewer Grid.Column="0" Grid.Row="0"
                  Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <StackPanel Margin="0,10,0,14">
        <ItemsControl ItemsSource="{Binding MainRail}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CommandEntry">
              <Panel>
                <Separator Classes="rail" IsVisible="{Binding IsSeparator}" />
                <Button Classes="rail" IsVisible="{Binding !IsSeparator}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunCommandCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="›" Opacity="0.35"
                               VerticalAlignment="Center" IsVisible="{Binding HasChildren}" />
                  </Grid>
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding Children}">
                      <MenuFlyout.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                      x:DataType="models:CommandEntry">
                          <Setter Property="Header" Value="{Binding Label}" />
                          <Setter Property="ItemsSource" Value="{Binding Children}" />
                          <Setter Property="Command"
                                  Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunCommandCommand}" />
                          <Setter Property="CommandParameter" Value="{Binding}" />
                        </ControlTheme>
                      </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Grid.Row="0"
            Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

    <!-- ================= main area (upstream pMain) ================= -->
    <Grid Grid.Column="2" Grid.Row="0" RowDefinitions="Auto,Auto,*">

      <!-- Capture toolbar -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,14,16,10">
        <Button Content="Fullscreen" Command="{Binding CaptureFullscreenCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Monitor" Command="{Binding CaptureActiveMonitorCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Window" Command="{Binding CaptureActiveWindowCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Region…" Command="{Binding CaptureRegionCommand}"
                IsEnabled="{Binding !IsBusy}" />

        <Border Width="1" Margin="4,2"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- After capture tasks, as a drop-down exactly like upstream's toolbar. -->
        <Button Content="After capture tasks ▾">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <ScrollViewer MaxHeight="420">
                <StackPanel Width="330" Margin="4">
                  <TextBlock Text="Applied to every capture, in ShareX's own order."
                             FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="6,4,6,8" />
                  <ItemsControl ItemsSource="{Binding AfterCaptureTasksList}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AfterCaptureTaskViewModel">
                        <StackPanel Margin="6,2">
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                    IsEnabled="{Binding Implemented}" FontSize="12" />
                          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                     FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                                     Margin="26,0,0,4" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Content="Screenshots folder…" Command="{Binding OpenScreenshotsFolderCommand}" />
      </StackPanel>

      <!-- Only shown while Screen Recording is missing; otherwise the main window
           carries no diagnostic clutter at all. -->
      <Border Grid.Row="1" Margin="16,0,16,10" Padding="12" CornerRadius="6"
              Background="#33FF9500" BorderBrush="#66FF9500" BorderThickness="1"
              IsVisible="{Binding NeedsRelaunch}">
        <StackPanel Spacing="8">
          <TextBlock Text="Screen Recording permission is required"
                     FontWeight="SemiBold" FontSize="13" />
          <TextBlock TextWrapping="Wrap" FontSize="12"
                     Text="Approve ShareX-Mac in the macOS dialog, or enable it in System Settings → Privacy &amp; Security → Screen &amp; System Audio Recording. macOS only applies a new grant to a newly launched process, so relaunch afterwards." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open System Settings…" Command="{Binding OpenPrivacySettingsCommand}" />
            <Button Content="Quit and reopen" Command="{Binding RelaunchAppCommand}" />
            <Button Content="Re-check" Command="{Binding RefreshPermissionsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- upstream scMain: task list above, preview below -->
      <Grid Grid.Row="2" RowDefinitions="*,6,1.2*" Margin="16,0,16,10">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="TASKS" Classes="sectionHeader" Margin="0,0,0,4" />
          <Grid Grid.Row="1" ColumnDefinitions="80,100,220,*" Margin="6,0,6,4">
            <TextBlock Grid.Column="0" Text="Time"   FontSize="11" Opacity="0.5" />
            <TextBlock Grid.Column="1" Text="Status" FontSize="11" Opacity="0.5" />
            <TextBlock Grid.Column="2" Text="File"   FontSize="11" Opacity="0.5" />
            <TextBlock Grid.Column="3" Text="Detail" FontSize="11" Opacity="0.5" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding Tasks}" FontSize="12"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskRowViewModel">
                <Grid ColumnDefinitions="80,100,220,*">
                  <TextBlock Grid.Column="0" Text="{Binding StartedText}" Classes="mono" />
                  <TextBlock Grid.Column="1" Text="{Binding Status}" />
                  <TextBlock Grid.Column="2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding Detail}" Opacity="0.7"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <GridSplitter Grid.Row="1" Background="Transparent" />

        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,4,0,6">
            <TextBlock Text="PREVIEW" Classes="sectionHeader" Margin="0" VerticalAlignment="Center" />
            <Button Content="Copy image" FontSize="11" Padding="8,3"
                    Command="{Binding CopyLastCaptureCommand}" />
            <Button Content="Reveal in Finder" FontSize="11" Padding="8,3"
                    Command="{Binding RevealLastCaptureCommand}" />
          </StackPanel>

          <Border Grid.Row="1" CornerRadius="6" Padding="8"
                  Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <TextBlock Grid.Row="2" Text="{Binding PreviewCaption}" Classes="mono"
                     TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,0" />
        </Grid>
      </Grid>
    </Grid>

    <!-- ================= status bar ================= -->
    <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
            BorderThickness="0,1,0,0" Padding="12,6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11"
                   Opacity="0.8" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Content="Diagnostics…" FontSize="11" Padding="8,2"
                Command="{Binding OpenDiagnosticsCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>
