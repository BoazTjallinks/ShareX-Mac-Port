<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Attributed fork of ShareX.ImageEditor from ShareX v21.0.0
    (commit d2502561f63fc3ff502cacd91514e3f7f2948c74).

    Per planning/adr/0004-editor-fork-strategy.md, only 5 of the upstream
    project's 428 .cs files touched Windows APIs. The upstream directory layout
    and file names are preserved so ancestry stays obvious and future upstream
    diffs remain readable.

    Changes from the upstream csproj:
      - net9.0 -> net10.0
      - dropped Vortice.Direct2D1 / Vortice.DXGI  (Direct2D/DirectWrite/DXGI)
      - dropped Microsoft.ML.OnnxRuntime.DirectML (DirectML execution provider)
      - dropped the x64;ARM64 Windows Platforms list
      - central package management, so versions are not repeated here
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ShareX.ImageEditor</RootNamespace>
    <!-- Assembly name kept as upstream: all 33 .axaml files reference
         assembly=ShareX.ImageEditor, and renaming it would mean editing every
         one of them for no benefit. -->
    <AssemblyName>ShareX.ImageEditor</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Upstream ships with warnings; treating them as errors would block the
         port for reasons that are not ours to fix. -->
    <NoWarn>$(NoWarn);CS0618;CS8618;CS8625;CS8600;CS8602;CS8604;CS8603;CS8601;AVLN5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\closedhand.cur" />
    <AvaloniaResource Include="Assets\Crosshair.cur" />
    <AvaloniaResource Include="Assets\lucide.ttf" />
    <AvaloniaResource Include="Assets\openhand.cur" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\emoji-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SkiaSharp" />
    <!-- CPU ONNX Runtime in place of upstream's DirectML build: same models and
         preprocessing, portable execution provider. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

</Project>
