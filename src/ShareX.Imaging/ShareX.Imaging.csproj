<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ShareX.Imaging</RootNamespace>
    <AssemblyName>ShareX.Imaging</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- All rasterisation goes through Skia; this project must never reference
         System.Drawing, which is what the upstream imaging code used. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
