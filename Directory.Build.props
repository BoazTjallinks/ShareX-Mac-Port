<Project>
  <!--
    ShareX-Mac build properties.
    Deliberately NOT a copy of reference/ShareX/Directory.build.props:
    the upstream file pins win-x64 / win-arm64 RuntimeIdentifiers unconditionally
    (see PROJECT-SPEC.md section 2, "Platform and dependency baseline").
  -->
  <PropertyGroup>
    <Company>Boaz Tjallinks (personal build)</Company>
    <Product>ShareX-Mac</Product>
    <!-- Upstream notice preserved; this project is a derivative port. -->
    <Copyright>Portions Copyright (c) 2007-2026 ShareX Team. macOS port Copyright (c) 2026 Boaz Tjallinks.</Copyright>
    <Version>21.0.0</Version>
    <InformationalVersion>21.0.0-mac</InformationalVersion>
    <UpstreamShareXVersion>21.0.0</UpstreamShareXVersion>
    <UpstreamShareXCommit>d2502561f63fc3ff502cacd91514e3f7f2948c74</UpstreamShareXCommit>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Stage 0 decision: JIT, no trimming/AOT. Upstream relies on reflection-based
         JSON type discovery; trimming is premature (PROJECT-SPEC.md section 2). -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>

    <EnableWindowsTargeting>false</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
